# Every variable the app reads. Placeholder / synthetic local values only.
# Copy to .env for local runs; never commit .env. Production values: docs/labs/lab05/deployment.md
NODE_ENV=development

# API listen port (Cloud Run injects PORT=8080)
PORT=3001
# Where the Next.js proxy sends /api/* (read at runtime by the web server)
API_BASE_URL=http://localhost:3001

# Matches docker-compose.yml (synthetic local credentials only)
DATABASE_HOST=localhost
# If another Postgres already uses 5432 on your machine, set e.g. 5434 here and in the shell
DATABASE_PORT=5432
DATABASE_USER=queue
DATABASE_PASSWORD=queue
DATABASE_NAME=queue_dev
# Test database: separate container on 5433, used only by npm test
DATABASE_PORT_TEST=5433
DATABASE_NAME_TEST=queue_test

# TLS to the database: false locally; true on Cloud Run (Supabase)
DATABASE_SSL=false
# Optional: PEM of the database CA (newlines may be written as \n). Verification stays on.
DATABASE_SSL_CA=
# Optional: set to false only to encrypt without verifying the certificate (document why)
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Max DB connections per API instance (default 30 for tests; use ~5 on Cloud Run with the Supabase pooler)
DB_POOL_MAX=30

SESSION_TTL_HOURS=8
# true only behind HTTPS (Cloud Run)
COOKIE_SECURE=false

# Password the seed writes for every demo account. Local placeholder; production value is in Secret Manager.
SEED_DEMO_PASSWORD=change_me_local_demo_password
